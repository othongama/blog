# Railway Environment Variables Template
# Configure estas variáveis no Railway Dashboard

# Backend Configuration
NODE_ENV=production
PORT=5000

# Database - Railway fornece automaticamente via DATABASE_URL
# Você pode usar a variável completa:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# OU variáveis individuais:
# DB_HOST=${{Postgres.PGHOST}}
# DB_PORT=${{Postgres.PGPORT}}
# DB_NAME=${{Postgres.PGDATABASE}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}

# JWT Secret (MUDE ISSO!)
JWT_SECRET=seu_secret_jwt_super_seguro_mude_isso_em_producao

# Frontend URL (para CORS) - Atualize com URL do seu frontend
FRONTEND_URL=https://seu-frontend.vercel.app

# Admin User - Credenciais iniciais (MUDE A SENHA!)
ADMIN_EMAIL=admin@monetizepro.com
ADMIN_PASSWORD=admin123_mude_isso_em_producao
ADMIN_NAME=Carlos Silva
