{
  "name": "monetizepro-backend",
  "version": "2.0.0",
  "description": "Backend API with TypeScript for MonetizePro blog CMS",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "db:setup": "ts-node src/utils/setupDatabase.ts",
    "deploy": "npm run db:setup && npm run build && npm start",
    "clean": "rm -rf node_modules dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["blog", "cms", "nodejs", "express", "postgresql", "typescript"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "^4.19.0",
    "pg": "^8.12.0",
    "dotenv": "^16.4.0",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "zod": "^3.23.0",
    "express-rate-limit": "^7.2.0",
    "sharp": "^0.33.0",
    "slugify": "^1.6.6",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/pg": "^8.11.0",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "nodemon": "^3.1.0"
  }
}
